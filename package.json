{
  "name": "slashr-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/export-archive.mjs && node scripts/verify-export.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "lucide-react": "1.59.0",
    "markdown-it": "15.0.3",
    "motion": "14.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
